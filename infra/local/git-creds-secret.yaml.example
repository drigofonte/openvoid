# git-creds Secret — example manifest.
#
# This Secret holds the platform's source-control PAT (per the v1 tenancy
# model: many users, one platform-owned source-control account; see
# docs/plans/2026-05-01-001-feat-v1-staged-walkthrough-plan.md, Key
# Technical Decisions → "Tenancy & repo-ownership model").
#
# The git-clone initContainer mounts this Secret via env-var
# `GIT_TOKEN`, injects it into the clone URL only at clone time, and
# `git remote set-url` strips it from the on-disk remote afterwards.
#
# Setup (NOT committed with a real value):
#   1. Create a fine-grained GitHub PAT scoped to one test repo with
#      "Contents: read+write" permissions.
#   2. Copy this file: `cp git-creds-secret.yaml.example git-creds-secret.yaml`
#   3. Replace <YOUR_PAT_HERE> with the token value.
#   4. Apply: `kubectl apply -f git-creds-secret.yaml`
#   5. Verify: `kubectl get secret git-creds -n openvoid-sessions`
#
# DO NOT commit the populated file. `.gitignore` should exclude
# `git-creds-secret.yaml` (without the .example suffix).
#
# v1.5 graduates to a GitHub App installed on the platform org; this
# Secret retires at that point.
apiVersion: v1
kind: Secret
metadata:
  name: git-creds
  namespace: openvoid-sessions
type: Opaque
stringData:
  token: <YOUR_PAT_HERE>
