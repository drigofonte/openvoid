# opencode-server-password Secret — example manifest.
#
# Holds the cluster-wide HTTP Basic password the OpenCode server
# requires to start (per the Phase 0.3 endpoint spike). The agent main
# container reads this via env var OPENCODE_SERVER_PASSWORD, projected
# from `secretKeyRef` on the per-session Pod manifest. Without it, the
# OpenCode entrypoint exits 1 before invoking the binary.
#
# In v1 this Secret is applied out-of-band — the same convention as
# `git-creds`. Phase 7's chart graduates this to a chart-templated
# Secret with an auto-generated default value (cluster-wide single
# string, rotated by re-installing the chart). The agent's threat
# model is per-session: even if one session's transcript leaked the
# password, every session in the cluster shares it, so it is treated
# as a low-sensitivity routing token rather than a per-user secret.
#
# Setup (NOT committed with a real value):
#   1. Choose any random string (a UUID or `openssl rand -base64 24`
#      both work). The value never leaves the cluster.
#   2. Copy: `cp opencode-password-secret.yaml.example opencode-password-secret.yaml`
#   3. Replace <YOUR_PASSWORD_HERE> with the chosen value.
#   4. Apply: `kubectl apply -f opencode-password-secret.yaml`
#   5. Verify: `kubectl get secret opencode-server-password -n openvoid-sessions`
#
# DO NOT commit the populated file. `.gitignore` excludes
# `opencode-password-secret.yaml` (without the .example suffix).
apiVersion: v1
kind: Secret
metadata:
  name: opencode-server-password
  namespace: openvoid-sessions
type: Opaque
stringData:
  password: <YOUR_PASSWORD_HERE>
