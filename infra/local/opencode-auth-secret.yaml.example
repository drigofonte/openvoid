# opencode-auth Secret — example manifest.
#
# Holds OpenCode's `auth.json` content — the LLM provider credentials
# OpenCode uses to call upstream APIs (Anthropic / OpenAI / OpenRouter,
# in any combination). Mounted as a single file at
# /var/opencode-data/opencode/auth.json on the agent main container
# only — never on git-clone or git-finalizer.
#
# Stays externally managed even after Phase 7's Helm chart lands —
# a real third-party LLM API key cannot be platform-auto-generated,
# same posture as `git-creds`.
#
# Auth shape (verified by Unit 6.0 spike,
# docs/spikes/2026-05-05-opencode-auth.md). Each provider entry is
# optional — populate only the provider(s) the platform operator
# intends to use; the v1 default in opencode.json
# (openrouter/anthropic/claude-sonnet-4.5) requires the openrouter
# entry to be set.
#
# Setup (NOT committed with a real value):
#   1. Obtain an API key from the provider(s) you want to use.
#      OpenRouter is the v1 recommended default — one key unlocks
#      dozens of upstream models. Sign up at https://openrouter.ai .
#   2. Copy: `cp opencode-auth-secret.yaml.example opencode-auth-secret.yaml`
#   3. Replace <YOUR_OPENROUTER_KEY> (and any other providers) with
#      real values. Remove provider entries you don't use.
#   4. Apply: `kubectl apply -f opencode-auth-secret.yaml`
#   5. Verify: `kubectl get secret opencode-auth -n openvoid-sessions`
#
# DO NOT commit the populated file. `.gitignore` excludes
# `opencode-auth-secret.yaml` (without the .example suffix).
apiVersion: v1
kind: Secret
metadata:
  name: opencode-auth
  namespace: openvoid-sessions
type: Opaque
stringData:
  auth.json: |
    {
      "openrouter": { "type": "api", "key": "<YOUR_OPENROUTER_KEY>" }
    }
