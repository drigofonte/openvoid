    "id128": "1.6.6"
  },
  "devDependencies": {
    "@openvoid/protocol": "workspace:*",
    "@types/node": "22.12.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "4.1.5"
  }
}
